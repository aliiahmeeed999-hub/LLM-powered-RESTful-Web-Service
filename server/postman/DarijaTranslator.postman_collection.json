{
  "info": {
    "name": "Darija Translator API",
    "description": "TranslatorResource tests. Set baseUrl / username / password in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}"
      },
      {
        "key": "password",
        "value": "{{password}}"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9080/translator/api"
    },
    {
      "key": "username",
      "value": "ali"
    },
    {
      "key": "password",
      "value": "darija2026"
    }
  ],
  "item": [
    {
      "name": "Health (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Translate JSON - Arabic script",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Hello my friend, how are you today?\",\n  \"sourceLang\": \"en\",\n  \"script\": \"arabic\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has translation', () => pm.expect(pm.response.json().translation).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Translate JSON - Latin script",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Je voudrais un thé à la menthe, s'il vous plaît\",\n  \"script\": \"latin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has translation', () => pm.expect(pm.response.json().translation).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Translate text/plain",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate?script=arabic",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ],
          "query": [
            {
              "key": "script",
              "value": "arabic"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "Where is the train station?"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Translate GET query",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/translate?text=See you tomorrow&script=latin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ],
          "query": [
            {
              "key": "text",
              "value": "See you tomorrow"
            },
            {
              "key": "script",
              "value": "latin"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has translation', () => pm.expect(pm.response.json().translation).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "No credentials -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Hello\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('challenge', () => pm.response.to.have.header('WWW-Authenticate'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Wrong password -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Hello\"}"
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "ali"
            },
            {
              "key": "password",
              "value": "wrong"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Empty text -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "translate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}