# Copy this file to "server.env" (same folder) and fill in your values.
# Open Liberty exports every line as an environment variable of the server process.
# server.env is git-ignored so your API key never lands in the repository.

# ---- LLM provider: gemini | ollama --------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (free tier key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Local lightweight LLM through Ollama (https://ollama.com) - e.g. `ollama pull qwen2.5:3b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Basic authentication users (username:password, comma separated) ----
TRANSLATOR_USERS=ali:darija2026,demo:demo123

# ---- Misc -----------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
MAX_TEXT_LENGTH=5000
CACHE_SIZE=500
